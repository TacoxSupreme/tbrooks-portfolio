---
import Base from "../layouts/Base.astro";
---

<Base title="Tyler Irby | Information System">
	<main class="landing">
		<header class="top-bar">
			<span>// PERSONAL INFORMATION SYSTEM</span>
			<span>STATUS: <b id="status">STANDBY</b></span>
		</header>

		<section class="center">
			<div class="earth-stage" id="earth-stage" aria-hidden="true">
				<div class="ring ring-1"></div>
				<div class="ring ring-2"></div>
				<div class="ring ring-3"></div>
			</div>

			<h1>TYLER'S PORTFOLIO</h1>
			<p class="tagline">ACTIVATE SYSTEM FOR ENTRY</p>

			<button id="activate" type="button"
				>ACTIVATE INFORMATION SYSTEM</button
			>
			<ul class="boot-log" id="boot-log" aria-live="polite"></ul>
		</section>
	</main>
</Base>

<style>
	.landing {
		position: relative;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.5rem;
	}
	.top-bar {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.95rem;
		color: var(--holo-dim);
	}
	.top-bar b {
		color: var(--holo);
		font-weight: 700;
	}

	.center {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 1rem;
	}

	.earth-stage :global(canvas) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.earth-stage {
		position: relative;
		width: min(80vw, 660px);
		aspect-ratio: 1;
		margin-bottom: 0.5rem;
	}
	.ring {
		position: absolute;
		border-radius: 50%;
		border: 1px solid var(--holo);
		box-shadow:
			0 0 18px var(--holo-glow),
			inset 0 0 18px var(--holo-glow);
	}
	.ring-1 {
		inset: 12%;
		opacity: 0.9;
	}
	.ring-2 {
		inset: 6%;
		opacity: 0.55;
		border-style: dashed;
		animation: spin 40s linear infinite;
	}
	.ring-3 {
		inset: -8%;
		opacity: 0.25;
		border-style: dotted;
		animation: spin 70s linear infinite reverse;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2rem, 7vw, 3.75rem);
		letter-spacing: 0.18em;
		color: var(--holo-bright);
		text-shadow:
			0 0 12px var(--holo-glow),
			0 0 32px var(--holo-glow);
	}
	.tagline {
		margin: 0;
		font-size: clamp(0.85rem, 2.4vw, 1.1rem);
		letter-spacing: 0.22em;
		color: var(--holo-dim);
	}

	button {
		margin-top: 1rem;
		padding: 0.95rem 2.2rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: 0.2em;
		color: var(--holo-bright);
		background: rgba(79, 209, 255, 0.08);
		border: 1px solid var(--holo);
		border-radius: 2px;
		box-shadow: 0 0 20px var(--holo-glow);
		cursor: pointer;
		transition:
			background 0.2s,
			box-shadow 0.2s;
	}
	button:hover:not(:disabled) {
		background: rgba(79, 209, 255, 0.22);
		box-shadow: 0 0 34px var(--holo-glow);
	}
	button:focus-visible {
		outline: 2px solid var(--holo-bright);
		outline-offset: 4px;
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.boot-log {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		min-height: 6rem;
		font-size: 1rem;
		color: var(--holo-dim);
	}
	/* :global is needed because these <li> are created by JavaScript */
	.boot-log :global(li) {
		animation: fade-in 0.3s ease both;
	}
	.boot-log :global(li)::before {
		content: "> ";
		color: var(--holo);
	}
</style>

<script>
	const stage = document.getElementById("earth-stage");
	if (stage) {
		const stage = document.getElementById("earth-stage");
		if (stage) {
			// Let the page paint first, then load Three.js.
			const start = () =>
				import("../scripts/earth").then(({ createEarth }) =>
					createEarth(stage),
				);
			if ("requestIdleCallback" in window)
				requestIdleCallback(start, { timeout: 800 });
			else setTimeout(start, 200);
		}
	}

	const button = document.getElementById("activate") as HTMLButtonElement;
	const log = document.getElementById("boot-log") as HTMLUListElement;
	const status = document.getElementById("status") as HTMLElement;

	const lines = [
		"Calibrating holoprojector...",
		"Linking field records...",
		"Mapping three sectors...",
		"Information system online.",
	];

	const reduced = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;
	const delay = reduced ? 150 : 650;
	const wait = (ms: number) =>
		new Promise((resolve) => setTimeout(resolve, ms));

	button.addEventListener("click", async () => {
		button.disabled = true;
		status.textContent = "INITIALIZING";

		for (const text of lines) {
			const li = document.createElement("li");
			li.textContent = text;
			log.appendChild(li);
			await wait(delay);
		}

		status.textContent = "ONLINE";
		await wait(delay);
		window.location.href = "/map";
	});
</script>
