---
import Base from "../layouts/Base.astro";
import { planets } from "../data/planets";
import { bases } from "../data/bases";
---

<Base title="Star Map | Tyler Irby">
    <main class="map-page">
        <div id="map-stage" class="map-stage" aria-hidden="true"></div>

        <div class="labels">
            {
                planets.map((p) => (
                    <button
                        class="planet-label"
                        data-planet={p.id}
                        type="button"
                    >
                        <span class="name">{p.name}</span>
                        <span class="field">{p.field}</span>
                    </button>
                ))
            }
        </div>

        <div class="labels">
            {
                bases.map((b) => (
                    <button class="base-label" data-base={b.id} type="button">
                        <span class="base-name">{b.name}</span>
                        <span class="base-period">{b.period}</span>
                    </button>
                ))
            }
        </div>

        <header class="top-bar">
            <a href="/" class="back" id="back-earth">&lt; RETURN TO EARTH</a>
            <button type="button" id="back-map" class="back back-btn" hidden
                >&lt; BACK TO STAR MAP</button
            >
            <span>STATUS: <b id="status">ONLINE</b></span>
        </header>

        <p class="hint" id="hint">SELECT A SECTOR</p>

        <aside id="planet-card" class="card" hidden aria-live="polite">
            <p class="card-field" id="card-field"></p>
            <h2 id="card-name"></h2>
            <p class="card-blurb" id="card-blurb"></p>
            <div class="card-actions">
                <button type="button" id="card-enter">ENTER SECTOR</button>
                <button type="button" id="card-close" class="ghost"
                    >CLOSE</button
                >
            </div>
        </aside>

        <aside id="base-card" class="card base-card" hidden aria-live="polite">
            <p class="card-field" id="base-period"></p>
            <h2 id="base-name"></h2>
            <p class="base-role" id="base-role"></p>
            <p class="card-blurb" id="base-summary"></p>
            <ul class="highlights" id="base-highlights"></ul>
            <div class="tags" id="base-tags"></div>
            <div class="card-actions">
                <button type="button" id="base-close" class="ghost"
                    >CLOSE</button
                >
            </div>
        </aside>
    </main>
</Base>

<style>
    .map-page {
        position: relative;
        height: 100svh;
    }
    .map-stage {
        position: absolute;
        inset: 0;
    }
    .map-stage :global(canvas) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .top-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        font-size: 0.95rem;
        color: var(--holo-dim);
    }
    .top-bar b {
        color: var(--holo);
        font-weight: 700;
    }
    .back {
        color: var(--holo);
        text-decoration: none;
    }
    .back:hover {
        color: var(--holo-bright);
        text-shadow: 0 0 10px var(--holo-glow);
    }
    .back-btn {
        padding: 0;
        background: none;
        border: none;
        font: inherit;
        letter-spacing: inherit;
        cursor: pointer;
    }

    .hint {
        position: absolute;
        bottom: 1.5rem;
        left: 0;
        right: 0;
        margin: 0;
        text-align: center;
        font-family: var(--font-display);
        font-size: 0.8rem;
        letter-spacing: 0.3em;
        color: var(--holo-dim);
    }

    /* ----- Labels ----- */
    .labels {
        position: absolute;
        inset: 0;
        z-index: 1;
        overflow: hidden;
        pointer-events: none;
    }
    .planet-label,
    .base-label {
        position: absolute;
        left: 0;
        top: 0;
        pointer-events: auto;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        background: rgba(2, 10, 22, 0.55);
        border: 1px solid rgba(79, 209, 255, 0.35);
        border-radius: 2px;
        color: var(--holo);
        font: inherit;
        white-space: nowrap;
        cursor: pointer;
        transition:
            border-color 0.2s,
            background 0.2s,
            box-shadow 0.2s,
            opacity 0.4s,
            visibility 0.4s;
    }
    .planet-label {
        align-items: center;
        padding: 0.35rem 0.8rem;
    }
    .name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.24em;
        color: var(--holo-bright);
    }
    .field {
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        color: var(--holo-dim);
    }
    .planet-label.is-hover,
    .planet-label.is-selected,
    .planet-label:focus-visible,
    .base-label.is-hover,
    .base-label.is-selected,
    .base-label:focus-visible {
        outline: none;
        border-color: var(--holo-bright);
        background: rgba(79, 209, 255, 0.14);
        box-shadow: 0 0 18px var(--holo-glow);
    }
    /* While visiting a planet, the other planets' labels fade out. */
    .planet-label.is-away {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .base-label {
        align-items: flex-start;
        padding: 0.3rem 0.7rem;
        border-left: 2px solid var(--holo);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
    .base-label.is-visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }
    .base-name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        color: var(--holo-bright);
    }
    .base-period {
        font-size: 0.78rem;
        letter-spacing: 0.14em;
        color: var(--holo-dim);
    }

    /* ----- Cards ----- */
    .card {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 3.4rem;
        margin: 0 auto;
        z-index: 3;
        width: min(92vw, 440px);
        padding: 1rem 1.25rem 1.1rem;
        background: rgba(2, 10, 22, 0.78);
        border: 1px solid var(--holo);
        box-shadow:
            0 0 28px var(--holo-glow),
            inset 0 0 24px rgba(79, 209, 255, 0.08);
        backdrop-filter: blur(6px);
        animation: fade-in 0.25s ease both;
    }
    .card[hidden] {
        display: none;
    }
    .card-field {
        margin: 0;
        font-size: 0.85rem;
        letter-spacing: 0.22em;
        color: var(--holo-dim);
    }
    .card h2 {
        margin: 0.2rem 0 0.4rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.6rem;
        letter-spacing: 0.18em;
        color: var(--holo-bright);
        text-shadow: 0 0 12px var(--holo-glow);
    }
    .card-blurb {
        margin: 0 0 1rem;
        color: var(--holo);
    }
    .card-actions {
        display: flex;
        gap: 0.75rem;
    }
    .card-actions button {
        padding: 0.65rem 1.3rem;
        font-family: var(--font-display);
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        color: var(--holo-bright);
        background: rgba(79, 209, 255, 0.1);
        border: 1px solid var(--holo);
        border-radius: 2px;
        cursor: pointer;
        transition:
            background 0.2s,
            box-shadow 0.2s;
    }
    .card-actions button:hover {
        background: rgba(79, 209, 255, 0.24);
        box-shadow: 0 0 18px var(--holo-glow);
    }
    .card-actions .ghost {
        border-color: rgba(79, 209, 255, 0.35);
        color: var(--holo-dim);
    }

    /* ----- Base detail panel ----- */
    .base-card {
        max-height: 55svh;
        overflow: auto;
    }
    .base-card h2 {
        font-size: 1.25rem;
        letter-spacing: 0.14em;
    }
    .base-role {
        margin: 0 0 0.8rem;
        font-size: 0.95rem;
        letter-spacing: 0.16em;
        color: var(--holo-dim);
    }
    .highlights {
        margin: 0 0 0.9rem;
        padding: 0;
        list-style: none;
    }
    /* :global is needed because these items are created by JavaScript */
    .highlights :global(li) {
        position: relative;
        padding-left: 1.1rem;
        margin-bottom: 0.35rem;
        color: var(--holo);
    }
    .highlights :global(li)::before {
        content: ">";
        position: absolute;
        left: 0;
        color: var(--holo-dim);
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }
    .tags :global(span) {
        padding: 0.15rem 0.6rem;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        color: var(--holo-bright);
        border: 1px solid rgba(79, 209, 255, 0.4);
        border-radius: 2px;
        background: rgba(79, 209, 255, 0.08);
    }

    @media (min-width: 800px) {
        .base-card {
            left: auto;
            right: 1.5rem;
            top: 5rem;
            bottom: 4rem;
            margin: 0;
            width: 380px;
            max-height: none;
        }
    }
    @media (max-width: 700px) {
        .field,
        .base-period {
            display: none;
        }
    }
</style>

<script>
    import { createStarMap } from "../scripts/starmap";
    import { planets } from "../data/planets";
    import { bases } from "../data/bases";

    const $ = <T extends HTMLElement>(id: string) =>
        document.getElementById(id) as T;

    const stage = $("map-stage");
    const hint = $("hint");
    const status = $("status");
    const backEarth = $("back-earth");
    const backMap = $("back-map");

    const planetCard = $("planet-card");
    const cardName = $("card-name");
    const cardField = $("card-field");
    const cardBlurb = $("card-blurb");
    const enterButton = $<HTMLButtonElement>("card-enter");
    const closeButton = $<HTMLButtonElement>("card-close");

    const baseCard = $("base-card");
    const basePeriod = $("base-period");
    const baseName = $("base-name");
    const baseRole = $("base-role");
    const baseSummary = $("base-summary");
    const baseHighlights = $("base-highlights");
    const baseTags = $("base-tags");
    const baseClose = $<HTMLButtonElement>("base-close");

    const labels = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>("[data-planet]").forEach((el) => {
        if (el.dataset.planet) labels.set(el.dataset.planet, el);
    });
    const baseLabels = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>("[data-base]").forEach((el) => {
        if (el.dataset.base) baseLabels.set(el.dataset.base, el);
    });

    let currentId: string | null = null;

    const map = createStarMap(stage, planets, bases, {
        labels,
        baseLabels,
        onSelect(planet) {
            currentId = planet ? planet.id : null;
            planetCard.hidden = !planet;
            if (planet) {
                cardName.textContent = planet.name;
                cardField.textContent = planet.field;
                cardBlurb.textContent = planet.blurb;
            }
        },
        onFocus(planet) {
            const visiting = !!planet;
            backEarth.hidden = visiting;
            backMap.hidden = !visiting;
            status.textContent = planet ? `SECTOR ${planet.name}` : "ONLINE";
            hint.textContent = visiting ? "SELECT A BASE" : "SELECT A SECTOR";
        },
        onBaseSelect(base) {
            baseCard.hidden = !base;
            if (!base) return;
            baseName.textContent = base.name;
            baseRole.textContent = base.role;
            basePeriod.textContent = base.period;
            baseSummary.textContent = base.summary;
            baseHighlights.replaceChildren(
                ...base.highlights.map((text) => {
                    const li = document.createElement("li");
                    li.textContent = text;
                    return li;
                }),
            );
            baseTags.replaceChildren(
                ...base.tags.map((text) => {
                    const tag = document.createElement("span");
                    tag.textContent = text;
                    return tag;
                }),
            );
        },
    });

    enterButton.addEventListener("click", () => {
        if (currentId) map?.enter(currentId);
    });
    closeButton.addEventListener("click", () => map?.select(null));
    baseClose.addEventListener("click", () => map?.selectBase(null));
    backMap.addEventListener("click", () => map?.exit());
    window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") map?.back();
    });
</script>
